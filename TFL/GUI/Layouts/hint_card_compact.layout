// 08 HINT CARD — компактный режим (800×320), без слота IMAGE.
// Имена виджетов совпадают с hint_card.layout: один контроллер TFL_HintCard.

FrameWidgetClass TFL_HintCardCompact
{
    position 0 0
    size 1 1
    {
        PanelWidgetClass tfl_hint_border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
        PanelWidgetClass tfl_hint_fill   { ignorepointer 1 position 0.00125 0.003125 size 0.9975 0.993750 color 0xff141819 }

        TextWidgetClass tfl_hint_category
        {
            ignorepointer 1
            position 0.05 0.125
            size 0.9 0.075
            text ""
            color 0xff7c8563
        }

        TextWidgetClass tfl_hint_title
        {
            ignorepointer 1
            position 0.05 0.25
            size 0.9 0.125
            text ""
            color 0xffecede9
        }

        MultilineTextWidgetClass tfl_hint_desc
        {
            ignorepointer 1
            position 0.05 0.4375
            size 0.9 0.365625
            text ""
            color 0xffd6d7d2
        }

        TextWidgetClass tfl_hint_counter
        {
            ignorepointer 1
            position 0.05 0.8
            size 0.4 0.075
            text ""
            color 0xff969b96
        }

        ButtonWidgetClass tfl_hint_prev
        {
            position 0.8 0.7375
            size 0.07 0.1375
            color 0x00000000
            {
                PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                PanelWidgetClass fill   { ignorepointer 1 position 0.017857 0.022727 size 0.964286 0.954545 color 0xff141819 }
                PanelWidgetClass mark   { ignorepointer 1 position 0 0.909091 size 1 0.090909 color 0x007c8563 }
                TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "<" color 0xffd6d7d2 }
            }
        }

        ButtonWidgetClass tfl_hint_next
        {
            position 0.88 0.7375
            size 0.07 0.1375
            color 0x00000000
            {
                PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                PanelWidgetClass fill   { ignorepointer 1 position 0.017857 0.022727 size 0.964286 0.954545 color 0xff141819 }
                PanelWidgetClass mark   { ignorepointer 1 position 0 0.909091 size 1 0.090909 color 0x007c8563 }
                TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text ">" color 0xffd6d7d2 }
            }
        }
    }
}
