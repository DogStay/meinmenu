// 08 HINT CARD (id 8a) — полный вариант, пропорции 800×660, padding 40.
// Хост создаёт этот layout внутрь контейнера нужного размера
// (loading 600×460, queue 600×400) — внутренние координаты относительные.

FrameWidgetClass TFL_HintCard
{
    position 0 0
    size 1 1
    {
        PanelWidgetClass tfl_hint_border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
        PanelWidgetClass tfl_hint_fill   { ignorepointer 1 position 0.00125 0.001515 size 0.9975 0.996970 color 0xff141819 }

        // 1 IMAGE — жёстко 8:3, во всю ширину карточки
        ImageWidgetClass tfl_hint_image
        {
            ignorepointer 1
            position 0 0
            size 1 0.454545
            mode blend
            "src alpha" 1
            "stretch mode" 1
            color 0xffffffff
        }

        // затемнение нижних 30% изображения
        PanelWidgetClass tfl_hint_image_dim
        {
            ignorepointer 1
            position 0 0.318182
            size 1 0.136364
            color 0x80090b0c
        }

        // 2 CATEGORY
        TextWidgetClass tfl_hint_category
        {
            ignorepointer 1
            position 0.05 0.515152
            size 0.9 0.036364
            text ""
            color 0xff7c8563
        }

        // 3 TITLE — одна строка
        TextWidgetClass tfl_hint_title
        {
            ignorepointer 1
            position 0.05 0.575758
            size 0.9 0.060606
            text ""
            color 0xffecede9
        }

        // 4 DESCRIPTION — до 3 строк, ellipsis
        MultilineTextWidgetClass tfl_hint_desc
        {
            ignorepointer 1
            position 0.05 0.660606
            size 0.9 0.177273
            text ""
            color 0xffd6d7d2
        }

        // 5 COUNTER
        TextWidgetClass tfl_hint_counter
        {
            ignorepointer 1
            position 0.05 0.903030
            size 0.4 0.036364
            text ""
            color 0xff969b96
        }

        // 6/7 ARROWS — 56×44
        ButtonWidgetClass tfl_hint_prev
        {
            position 0.8 0.872727
            size 0.07 0.066667
            color 0x00000000
            {
                PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                PanelWidgetClass fill   { ignorepointer 1 position 0.017857 0.022727 size 0.964286 0.954545 color 0xff141819 }
                PanelWidgetClass mark   { ignorepointer 1 position 0 0.909091 size 1 0.090909 color 0x007c8563 }
                TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "<" color 0xffd6d7d2 }
            }
        }

        ButtonWidgetClass tfl_hint_next
        {
            position 0.88 0.872727
            size 0.07 0.066667
            color 0x00000000
            {
                PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                PanelWidgetClass fill   { ignorepointer 1 position 0.017857 0.022727 size 0.964286 0.954545 color 0xff141819 }
                PanelWidgetClass mark   { ignorepointer 1 position 0 0.909091 size 1 0.090909 color 0x007c8563 }
                TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text ">" color 0xffd6d7d2 }
            }
        }
    }
}
