FrameWidgetClass TFL_MainMenuRoot
{
    position 0 0
    size 1 1
    {
        // ------------------------------------------------------------------
        // BACKGROUND  (cinematic zoom 8% / 40s ping-pong -> TFLMainMenu.Update)
        // ------------------------------------------------------------------
        ImageWidgetClass tfl_bg
        {
            ignorepointer 1
            position 0 0
            size 1 1
            image0 "TFL/GUI/textures/mainmenu_background.paa"
            mode blend
            "src alpha" 1
            "stretch mode" 1
            color 0xffffffff
        }

        // Bottom gradient 0 -> 85% over the lowest 420px (7 bands, base #090B0C)
        PanelWidgetClass tfl_grad_0 { ignorepointer 1 position 0 0.611111 size 1 0.055556 color 0x11090b0c }
        PanelWidgetClass tfl_grad_1 { ignorepointer 1 position 0 0.666667 size 1 0.055556 color 0x30090b0c }
        PanelWidgetClass tfl_grad_2 { ignorepointer 1 position 0 0.722222 size 1 0.055556 color 0x52090b0c }
        PanelWidgetClass tfl_grad_3 { ignorepointer 1 position 0 0.777778 size 1 0.055556 color 0x77090b0c }
        PanelWidgetClass tfl_grad_4 { ignorepointer 1 position 0 0.833333 size 1 0.055556 color 0x9c090b0c }
        PanelWidgetClass tfl_grad_5 { ignorepointer 1 position 0 0.888889 size 1 0.055556 color 0xbe090b0c }
        PanelWidgetClass tfl_grad_6 { ignorepointer 1 position 0 0.944444 size 1 0.055556 color 0xd9090b0c }

        // Extra 8% dim, enabled only while a tooltip / hover is up (id 5b)
        PanelWidgetClass tfl_dim
        {
            ignorepointer 1
            position 0 0
            size 1 1
            color 0x00090b0c
        }

        // ------------------------------------------------------------------
        // LOGO BLOCK  (centered X, y=180, 700x160)
        // ------------------------------------------------------------------
        TextWidgetClass tfl_logo_title
        {
            ignorepointer 1
            position 0.317708 0.166667
            size 0.364583 0.096296
            text "THE FIRST LINE"
            color 0xffecede9
        }

        PanelWidgetClass tfl_logo_mark
        {
            ignorepointer 1
            position 0.475 0.277778
            size 0.05 0.003704
            color 0xff7c8563
        }

        TextWidgetClass tfl_logo_sub
        {
            ignorepointer 1
            position 0.317708 0.292593
            size 0.364583 0.027778
            text "MILITARY ROLEPLAY"
            color 0xff969b96
        }

        // ------------------------------------------------------------------
        // TOOLTIP  (340x110, above SERVERS, 400ms delay -> TFLTooltip)
        // ------------------------------------------------------------------
        PanelWidgetClass tfl_tooltip
        {
            ignorepointer 1
            position 0.269792 0.664815
            size 0.177083 0.101852
            color 0x0023282a
            {
                PanelWidgetClass fill
                {
                    ignorepointer 1
                    position 0.002941 0.009091
                    size 0.994118 0.981818
                    color 0xff141819
                }
                TextWidgetClass tfl_tooltip_title
                {
                    ignorepointer 1
                    position 0.070588 0.163636
                    size 0.858824 0.245455
                    text ""
                    color 0xffecede9
                }
                TextWidgetClass tfl_tooltip_text
                {
                    ignorepointer 1
                    position 0.070588 0.472727
                    size 0.858824 0.363636
                    text ""
                    color 0xff969b96
                }
            }
        }

        PanelWidgetClass tfl_tooltip_arrow
        {
            ignorepointer 1
            position 0.282292 0.766667
            size 0.00625 0.007407
            color 0x00141819
        }

        // ------------------------------------------------------------------
        // ACTION BAR  (x=88, 1744x176, bottom stack: status 21 from bottom,
        //              24 gap up to the bar -> bar y = 791)
        // ------------------------------------------------------------------
        PanelWidgetClass tfl_action_bar
        {
            position 0.045833 0.732407
            size 0.908333 0.162963
            color 0xe6141819
            {
                PanelWidgetClass top_line
                {
                    ignorepointer 1
                    position 0 0
                    size 1 0.005682
                    color 0xff23282a
                }

                // ---- PLAY (primary, 370x104, olive fill + border + mark) ----
                ButtonWidgetClass tfl_btn_play
                {
                    position 0.020642 0.204545
                    size 0.212156 0.590909
                    color 0x00000000
                    {
                        PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff7c8563 }
                        PanelWidgetClass fill   { ignorepointer 1 position 0.002703 0.009615 size 0.994595 0.980769 color 0x29697254 }
                        PanelWidgetClass mark   { ignorepointer 1 position 0 0.961538 size 1 0.038462 color 0xff7c8563 }
                        TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "ИГРАТЬ" color 0xffecede9 }
                    }
                }

                // ---- SERVERS (secondary, 240x70) ----
                ButtonWidgetClass tfl_btn_servers
                {
                    position 0.246560 0.301136
                    size 0.137615 0.397727
                    color 0x00000000
                    {
                        PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                        PanelWidgetClass fill   { ignorepointer 1 position 0.004167 0.014286 size 0.991667 0.971429 color 0xff141819 }
                        PanelWidgetClass mark   { ignorepointer 1 position 0 0.942857 size 1 0.057143 color 0x007c8563 }
                        TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "СЕРВЕРЫ" color 0xffd6d7d2 }
                    }
                }

                // ---- CHARACTER (secondary, 240x70) ----
                ButtonWidgetClass tfl_btn_character
                {
                    position 0.397936 0.301136
                    size 0.137615 0.397727
                    color 0x00000000
                    {
                        PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                        PanelWidgetClass fill   { ignorepointer 1 position 0.004167 0.014286 size 0.991667 0.971429 color 0xff141819 }
                        PanelWidgetClass mark   { ignorepointer 1 position 0 0.942857 size 1 0.057143 color 0x007c8563 }
                        TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "ПЕРСОНАЖ" color 0xffd6d7d2 }
                    }
                }

                // ---- SETTINGS (secondary, 240x70) ----
                ButtonWidgetClass tfl_btn_settings
                {
                    position 0.549312 0.301136
                    size 0.137615 0.397727
                    color 0x00000000
                    {
                        PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                        PanelWidgetClass fill   { ignorepointer 1 position 0.004167 0.014286 size 0.991667 0.971429 color 0xff141819 }
                        PanelWidgetClass mark   { ignorepointer 1 position 0 0.942857 size 1 0.057143 color 0x007c8563 }
                        TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "НАСТРОЙКИ" color 0xffd6d7d2 }
                    }
                }

                // ---- divider 1x80 ----
                PanelWidgetClass tfl_divider
                {
                    ignorepointer 1
                    position 0.700688 0.272727
                    size 0.000573 0.454545
                    color 0xff23282a
                }

                // ---- DISCORD (icon, 96x70) ----
                ButtonWidgetClass tfl_btn_discord
                {
                    position 0.715023 0.301136
                    size 0.055046 0.397727
                    color 0x00000000
                    {
                        PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                        PanelWidgetClass fill   { ignorepointer 1 position 0.010417 0.014286 size 0.979167 0.971429 color 0xff141819 }
                        PanelWidgetClass mark   { ignorepointer 1 position 0 0.942857 size 1 0.057143 color 0x007c8563 }
                        TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "DS" color 0xffd6d7d2 }
                    }
                }

                // ---- WEBSITE (icon, 96x70) ----
                ButtonWidgetClass tfl_btn_website
                {
                    position 0.783830 0.301136
                    size 0.055046 0.397727
                    color 0x00000000
                    {
                        PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff23282a }
                        PanelWidgetClass fill   { ignorepointer 1 position 0.010417 0.014286 size 0.979167 0.971429 color 0xff141819 }
                        PanelWidgetClass mark   { ignorepointer 1 position 0 0.942857 size 1 0.057143 color 0x007c8563 }
                        TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "WWW" color 0xffd6d7d2 }
                    }
                }

                // ---- EXIT (danger, 228x70, right aligned) ----
                ButtonWidgetClass tfl_btn_exit
                {
                    position 0.848624 0.301136
                    size 0.130734 0.397727
                    color 0x00000000
                    {
                        PanelWidgetClass border { ignorepointer 1 position 0 0 size 1 1 color 0xff4a3335 }
                        PanelWidgetClass fill   { ignorepointer 1 position 0.004386 0.014286 size 0.991228 0.971429 color 0xff141819 }
                        PanelWidgetClass mark   { ignorepointer 1 position 0 0.942857 size 1 0.057143 color 0x008a5c5c }
                        TextWidgetClass  label  { ignorepointer 1 position 0 0 size 1 1 text "ВЫХОД" color 0xffd6d7d2 }
                    }
                }
            }
        }

        // ------------------------------------------------------------------
        // STATUS BAR  (x=88, 1744x68, 21 from bottom)
        // ------------------------------------------------------------------
        PanelWidgetClass tfl_status_bar
        {
            ignorepointer 1
            position 0.045833 0.917593
            size 0.908333 0.062963
            color 0x00000000
            {
                TextWidgetClass tfl_status_online  { ignorepointer 1 position 0.000 0.25 size 0.130 0.5 text "ONLINE  --/--"      color 0xff969b96 }
                TextWidgetClass tfl_status_server  { ignorepointer 1 position 0.140 0.25 size 0.150 0.5 text "SERVER  --"         color 0xff969b96 }
                TextWidgetClass tfl_status_version { ignorepointer 1 position 0.300 0.25 size 0.130 0.5 text "VERSION --"         color 0xff969b96 }
                TextWidgetClass tfl_status_ping    { ignorepointer 1 position 0.440 0.25 size 0.130 0.5 text "PING    -- ms"      color 0xff969b96 }
                TextWidgetClass tfl_status_line    { ignorepointer 1 position 0.600 0.25 size 0.400 0.5 text ""                   color 0xff5c6360 }
            }
        }
    }
}
